# Copia este archivo a .env (git lo ignora) y poné valores reales:
#   cp .env.example .env
DB_USER=postgres
DB_PASSWORD=super-secreto-local
DB_NAME=misgastos

# Sentry (monitoreo de errores del backend). OPCIONAL: sin SENTRY_DSN, Sentry queda apagado.
# No se definen aqui: se cargan como variables de entorno del servicio en Render (solo PROD).
#   SENTRY_DSN          -> direccion del proyecto "backend" en Sentry
#   SENTRY_ENVIRONMENT  -> nombre del entorno que se ve en Sentry (ej. production)
